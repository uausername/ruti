diff --git a/codex-rs/tui/src/ruti_status.rs b/codex-rs/tui/src/ruti_status.rs
new file mode 100644
index 0000000..cc4e1fa
--- /dev/null
+++ b/codex-rs/tui/src/ruti_status.rs
@@ -0,0 +1,204 @@
+//! Optional Ruti footer item. Only an explicitly supplied absolute Python path
+//! can enable polling; project configuration cannot supply a shell command.
+
+use std::io::Read;
+use std::path::Path;
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::time::Duration;
+use std::time::Instant;
+
+use tokio::io::AsyncReadExt;
+use tokio::process::Command;
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+
+pub(crate) const REFRESH_INTERVAL: Duration = Duration::from_secs(5);
+const COMMAND_TIMEOUT: Duration = Duration::from_secs(4);
+const MAX_OUTPUT_BYTES: u64 = 4096;
+
+#[derive(Default)]
+pub(crate) struct RutiStatus {
+    session: Option<String>,
+    text: Option<String>,
+    pending: bool,
+    last_requested: Option<Instant>,
+}
+
+impl RutiStatus {
+    pub(crate) fn due(&self, session: &str) -> bool {
+        self.session.as_deref() != Some(session)
+            || (!self.pending
+                && self
+                    .last_requested
+                    .is_none_or(|last| last.elapsed() >= REFRESH_INTERVAL))
+    }
+
+    pub(crate) fn value(&self, session: Option<String>) -> String {
+        if self.session == session {
+            self.text
+                .clone()
+                .unwrap_or_else(|| "Ruti loading".to_string())
+        } else {
+            "Ruti ready".to_string()
+        }
+    }
+
+    pub(crate) fn request(&mut self, session: String, cwd: PathBuf, tx: AppEventSender) {
+        if !self.due(&session) {
+            return;
+        }
+        if self.session.as_deref() != Some(&session) {
+            self.text = None;
+            self.pending = false;
+        }
+        self.session = Some(session.clone());
+        self.last_requested = Some(Instant::now());
+        let Some(python) = python_path() else {
+            self.text = Some("Ruti setup needed".to_string());
+            return;
+        };
+        if !python.is_absolute() || !python.is_file() {
+            self.text = Some("Ruti invalid Python path".to_string());
+            return;
+        }
+        self.pending = true;
+        tokio::spawn(async move {
+            let text = match tokio::time::timeout(COMMAND_TIMEOUT, invoke(&python, &session, &cwd))
+                .await
+            {
+                Ok(Ok(text)) => text,
+                Ok(Err(_)) => "Ruti unavailable".to_string(),
+                Err(_) => "Ruti timeout".to_string(),
+            };
+            tx.send(AppEvent::RutiStatusUpdated {
+                session_id: session,
+                text,
+            });
+        });
+    }
+
+    pub(crate) fn set_result(&mut self, session: &str, text: String) -> bool {
+        if self.session.as_deref() != Some(session) {
+            return false;
+        }
+        self.pending = false;
+        self.text = Some(sanitize(&text));
+        true
+    }
+}
+
+fn python_path() -> Option<PathBuf> {
+    if let Some(path) = std::env::var_os("RUTI_STATUSLINE_PYTHON") {
+        return Some(PathBuf::from(path));
+    }
+    let root = std::env::var_os("RUTI_HOME")
+        .map(PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("LOCALAPPDATA").map(|base| PathBuf::from(base).join("ruti"))
+        })?;
+    let file = std::fs::File::open(root.join("codex-cli").join("python.path")).ok()?;
+    let mut bytes = Vec::new();
+    file.take(4097).read_to_end(&mut bytes).ok()?;
+    if bytes.len() > 4096 {
+        return None;
+    }
+    String::from_utf8(bytes)
+        .ok()
+        .map(|value| PathBuf::from(value.trim()))
+}
+
+async fn invoke(python: &Path, session: &str, _cwd: &Path) -> std::io::Result<String> {
+    let mut command = Command::new(python);
+    command
+        .args([
+            "-I",
+            "-X",
+            "utf8",
+            "-m",
+            "ruti.footer",
+            "--session-id",
+            session,
+        ])
+        .env("RUTI_HOST", "codex")
+        .env("RUTI_SESSION_ID", session)
+        .current_dir(
+            python
+                .parent()
+                .ok_or_else(|| std::io::Error::other("invalid Python path"))?,
+        )
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true);
+    #[cfg(windows)]
+    command.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+    let mut child = command.spawn()?;
+    let stdout = child
+        .stdout
+        .take()
+        .ok_or_else(|| std::io::Error::other("no stdout"))?;
+    let mut bytes = Vec::new();
+    stdout
+        .take(MAX_OUTPUT_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .await?;
+    if bytes.len() as u64 > MAX_OUTPUT_BYTES {
+        return Err(std::io::Error::other("footer output exceeds limit"));
+    }
+    if !child.wait().await?.success() {
+        return Err(std::io::Error::other("footer command failed"));
+    }
+    let text = sanitize(&String::from_utf8_lossy(&bytes));
+    if text.is_empty() {
+        return Err(std::io::Error::other("empty footer"));
+    }
+    Ok(text)
+}
+
+fn sanitize(text: &str) -> String {
+    text.chars()
+        .filter(|ch| !ch.is_control())
+        .take(160)
+        .collect::<String>()
+        .trim()
+        .to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bounds_untrusted_output_and_removes_controls() {
+        assert_eq!(sanitize("Ruti\n on\r\t\u{1b}"), "Ruti on");
+        assert_eq!(sanitize(&"я".repeat(200)).chars().count(), 160);
+    }
+
+    #[test]
+    fn result_for_previous_thread_cannot_replace_current_thread() {
+        let mut state = RutiStatus {
+            session: Some("current".to_string()),
+            pending: true,
+            ..Default::default()
+        };
+        assert!(!state.set_result("old", "wrong".to_string()));
+        assert!(state.pending);
+        assert!(state.set_result("current", "Ruti on".to_string()));
+        assert!(!state.pending);
+        assert_eq!(state.value(Some("current".to_string())), "Ruti on");
+        assert_eq!(state.value(Some("other".to_string())), "Ruti ready");
+    }
+
+    #[test]
+    fn pending_and_recent_requests_are_not_repeated() {
+        let state = RutiStatus {
+            session: Some("current".to_string()),
+            last_requested: Some(Instant::now()),
+            ..Default::default()
+        };
+        assert!(!state.due("current"));
+        assert!(state.due("next"));
+    }
+}
