# Secrets - never commit real API keys (see litellm/.env.example for the template)
.env
litellm/.env

# Runtime output
*.log

# Rebuilt from this machine's state by `ruti models sync` and `ruti provider add`.
# start-litellm.ps1 stubs them on a fresh clone so the include: never dangles.
litellm/models.generated.yaml
litellm/providers.generated.yaml

# Python packaging
__pycache__/
*.egg-info/
build/
dist/

# Local scratch
scratch*/

# The originating proposal. Kept on disk for reference, deliberately out of the
# repository: it is a private document and this repository is public.
docs/*.pdf

# Local-only Claude Code permission cache
.claude/settings.local.json
