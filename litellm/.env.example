# Copy to .env and fill in real keys. .env is gitignored.
# Two keys from different Google Cloud projects: the router rotates between them
# and cools one down for 60s when it returns 429, so you get the sum of both free tiers.
GEMINI_KEY_A=your-first-google-ai-studio-key
GEMINI_KEY_B=your-second-google-ai-studio-key

# Only needed if something on your machine terminates TLS - corporate proxies and
# consumer antivirus "web shields" both do. Their root is in the OS trust store but
# not in certifi, which is what LiteLLM verifies against, so every provider call
# fails with CERTIFICATE_VERIFY_FAILED. `ruti doctor --fix-tls` builds a bundle that
# merges both stores and writes this line for you.
# SSL_CERT_FILE=C:\Users\you\AppData\Local\ruti\ca-bundle.pem
