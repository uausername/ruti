# Copy to .env and fill in real keys. .env is gitignored.
# Two keys from different Google Cloud projects: the router rotates between them
# and cools one down for 60s when it returns 429, so you get the sum of both free tiers.
GEMINI_KEY_A=your-first-google-ai-studio-key
GEMINI_KEY_B=your-second-google-ai-studio-key
